/* ============================================================
   FIREBASE STORAGE SECURITY RULES
   ============================================================
   HOW TO USE:
   In the Firebase Console → Storage → Rules tab, paste this
   entire file's contents and click "Publish".

   Only needed if you want to upload project images through
   admin.html. If you'd rather skip Storage entirely, just paste
   image URLs (e.g. from anywhere you already host images) — the
   "Project Image" field in admin.html is optional either way.
   ============================================================ */

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'ramagoma212@gmail.com'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
